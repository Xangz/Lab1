<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - Management System</title>
    <!-- Cấu hình đường dẫn CSS tĩnh chuẩn trong wwwroot -->
    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
</head>
<body class="sb-nav-fixed">
    <!-- 1. Top Nav (Thanh điều hướng trên cùng) -->
    <partial name="TopNav" />

    <div id="layoutSidenav" class="d-flex">
        <!-- 2. Left Menu (Menu bên trái) -->
        <div id="layoutSidenav_nav" style="min-width: 220px; background-color: #212529;" class="text-white p-3">
            @await Component.InvokeAsync("Render")
        </div>

        <!-- 3. Nội dung chính chính giữa -->
        <div id="layoutSidenav_content" class="flex-grow-1 p-4">
            <main>
                <div class="container-fluid px-4">
                    <!-- Hiển thị View con tại đây -->
                    @RenderBody()
                </div>
            </main>

            <!-- 4. Footer (Chân trang) -->
            <footer class="py-4 bg-light mt-auto border-top text-center mt-5">
                <partial name="Footer" />
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    <!-- RenderSection với required: false (Không bắt buộc mọi View phải có) -->
    @RenderSection("Scripts", required: false)
</body>
</html>