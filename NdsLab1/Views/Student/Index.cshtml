@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}
@model IEnumerable<Student>

<a asp-route="student_add" class="btn btn-primary">Create Student</a>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <!-- BỔ SUNG THẺ NÀY ĐỂ KHỚP VỚI CỘT <td> CHỨA ẢNH Ở DƯỚI -->
            <th>Ảnh đại diện</th>

            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ ĐT</th>
            <th>Địa chỉ</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(s.AvatarPath))
                    {
                        <img src="@s.AvatarPath" alt="Avatar" width="50" height="50" style="object-fit:cover; border-radius:50%;" />
                    }
                    else
                    {
                        <span>Không có ảnh</span>
                    }
                </td>

                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.DateOfBirth.ToString("dd/MM/yyyy")</td>
                <td>
                    @{
                        string str = "";
                        switch (s.Branch)
                        {
                            case Branch.IT: str = "CNTT"; break;
                            case Branch.BE: str = "Kinh tế"; break;
                            case Branch.CE: str = "Công trình"; break;
                            case Branch.EE: str = "Điện - Điện tử"; break;
                        }
                    }
                    @str
                </td>
                <td>@(s.Gender == Gender.Male ? "Nam" : "Nữ")</td>
                <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                <td>@s.Address</td>
                <td>@s.Email</td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script>
        var table = document.querySelector("table");
        if (table) {
            table.onclick = function onTableClick() {
                console.log("Đã click vào bảng danh sách sinh viên.");
            }
        }
    </script>
}